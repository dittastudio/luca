{
  "name": "luca",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sb:login": "storyblok login",
    "sb:logout": "storyblok logout",
    "sb:help": "storyblok --help",
    "sb:components": "storyblok components pull --space 285210 --verbose",
    "sb:types": "storyblok types generate --space 285210 --strict",
    "dev": "npm run sb:components && npm run sb:types && nuxt dev --host",
    "dev:ssl": "local-ssl-proxy --source 3010 --target 3000 --cert localhost.pem --key localhost-key.pem",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "nuke": "del-cli '.output' 'dist' '.nuxt' 'node_modules' 'package-lock.json'"
  },
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "@storyblok/nuxt": "^11.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "jsdom": "^30.0.1",
    "lodash-es": "^4.18.1",
    "postcss-nested": "^8.0.1",
    "swiper": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vee-validate": "^4.15.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/mailchimp__mailchimp_marketing": "^3.0.22",
    "@types/node": "^26.4.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "^5.0.0",
    "prettier": "^3.9.6",
    "storyblok": "^4.22.4",
    "vite-svg-loader": "^5.1.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "overrides": {
    "zod": "^4.5.4"
  }
}
